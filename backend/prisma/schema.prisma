generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Course {
  id    String       @id @default(auto()) @map("_id") @db.ObjectId
  code  String       @unique
  name  String
  slots CourseSlot[]
}

model CourseSlot {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  course    Course  @relation(fields: [courseId], references: [id])
  courseId  String  @db.ObjectId
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?

  @@unique([courseId, dayOfWeek, startTime, endTime, room], name: "courseId_dayOfWeek_startTime_endTime_room")
}

model SolveRun {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  payload   String
}

model SavedSchedule {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime            @default(now())
  userId     String?             @db.ObjectId
  user       User?               @relation(fields: [userId], references: [id])
  explanation String?
  payload    String              // JSON string of saved schedule (items + metadata)
  items      SavedScheduleItem[]
}

model SavedScheduleItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  schedule   SavedSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId String @db.ObjectId
  courseCode String?
  courseName String?
  section    String?
  dayOfWeek  Int
  startTime  String
  endTime    String
  room       String?
}

model User {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String          @unique
  school     String?
  department String?
  password   String
  role       Role             @default(user)
  createdAt  DateTime        @default(now())

  schedules  SavedSchedule[]
}

enum Role {
  user
  admin
}
